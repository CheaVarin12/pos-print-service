{
  "name": "foodmonsterprint",
  "version": "0.3.0",
  "description": "FoodMonsterPrint - Windows print service for the FoodMonster POS (Print Service v2)",
  "private": true,
  "type": "commonjs",
  "main": "dist/src/index.js",
  "bin": {
    "foodmonsterprint": "dist/src/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/src/index.js run",
    "fake-printer": "tsx tools/fake-printer.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "koffi": "2.16.3",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
